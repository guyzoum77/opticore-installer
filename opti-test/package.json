{
    "name": "opticore-api-restfull-template-postgresdb",
    "version": "1.0.0",
    "description": "Opticore API Restfull template with postgres as database",
    "scripts": {
        "opticore": "tsx src/app/bin/console.bin.ts",
        "start:prod": "tsx server.ts",
        "start:dev": " tsx server.ts",
        "test": "jest --forceExit --detectOpenHandles",
        "deploy:prod": "npm run build && pm2 start ecosystem.config.js --only prod",
        "deploy:dev": "pm2 start ecosystem.config.js --only dev",
        "lint": "ESLINT_USE_FLAT_CONFIG=true eslint --ext .ts src/",
        "lint:fix": "ESLINT_USE_FLAT_CONFIG=true eslint --fix --ext .ts src/"
    },
    "repository": {
        "type": "git",
        "url": "git+ https://github.com/guyzoum77/opticore-api-restfull-template-postgresdb.git"
    },
    "author": "Guy-serge Kouacou",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/guyzoum77/opticore-api-restfull-template-postgresdb.git/issues"
    },
    "homepage": "https://github.com/guyzoum77/opticore-api-restfull-template-postgresdb.git#readme",
    "dependencies": {
        "@types/gradient-string": "^1.1.6",
        "nunjucks": "^3.2.4",
        "opticore-cli": "^1.0.5",
        "opticore-dependency-inject": "^1.0.11",
        "opticore-env-access": "^1.0.26",
        "opticore-express": "^1.0.9",
        "opticore-http-response": "^1.0.11",
        "opticore-logger": "^1.0.34",
        "opticore-postgres": "^1.0.2",
        "opticore-profiler": "^1.0.8",
        "opticore-router": "^1.0.24",
        "opticore-server-logger": "^1.0.16",
        "opticore-webapp": "^1.0.89",
        "opticore-webapp-core": "^1.0.22",
        "reflect-metadata": "^0.2.2"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.6",
        "@eslint/js": "^10.0.1",
        "@types/node": "^22.14.0",
        "@typescript-eslint/eslint-plugin": "^8.68.0",
        "@typescript-eslint/parser": "^8.68.0",
        "concurrently": "^10.0.5",
        "cross-env": "^10.1.0",
        "eslint": "^10.9.1",
        "globals": "^17.11.0",
        "supertest": "^7.1.1",
        "tsx": "^4.19.4",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.68.0"
    },
    "overrides": {
        "qs": "^6.15.3",
        "jws": "^3.2.3",
        "brace-expansion": "^1.1.18",
        "lodash": "^4.18.1",
        "minimatch": "^3.1.5",
        "shell-quote": "^1.10.0",
        "flatted": "^3.4.4",
        "glob": "^10.5.0",
        "rollup": "^4.62.4",
        "esbuild": "^0.28.1",
        "diff": "^4.0.4"
    }
}